# --- FPGA / HDL build and simulation outputs ---
firmware/**/build/
hardware/**/build/

*.o
*.cf
*.ghw
*.vcd
*.fst
e~*.o

# --- KiCad ---
*-backups/
fp-info-cache
*.kicad_prl
*.lck
~*.lck
_autosave-*
*.bak
# FreeRouting exchange files (regenerate when needed)
*.dsn
*.ses
# Generated fabrication/assembly outputs (published as release assets)
production/

# --- Tools / local ---
tools/containers/*/cache/
__pycache__/
*.pyc

# --- Raw media dropped from phones (curate into docs/media/ instead) ---
WhatsApp*

# Experiment builds write next to their sources
firmware/experiments/*/hardware.*
firmware/experiments/*/wave.*

# Signal-integrity plots are regenerated by the scripts
hardware/si/*.png
hardware/si/measurements/*.ppm
hardware/si/measurements/*.png
hardware/si/models/*.ibs
