// SPDX-License-Identifier: CERN-OHL-S-2.0
//
// tile_gw1nz_board.cst  --  BOARD/production pin map for the single-PCB FPGA
// tile on Gowin GW1NZ-LV1QN48C6/I5 (QN48 = QFN48 6x6 mm, 0.4 mm pitch).
//
// SUPERSEDES the synth proof-of-concept map ../synth/tile_gw1nz.cst, which
// was an empirical nextpnr chipdb probe ("legal proposal, not a routed
// board"). Every pin here is verified against the current Gowin vendor
// documents fetched 2026-10-12 (see ../data/pins_gw1nz_qn48.json for the
// per-pin provenance + file sha256s):
//   * UG842-1.6.8E "GW1NZ-1 Pinout" p.6-7 pin list, QN48 column;
//   * DS841-2.8E "GW1NZ Datasheet" (rails/ramp/AUTO-BOOT/osc/POR);
//   * UG290-2.9.1E mode table (MODE[2:0]=000 -> AUTO BOOT from on-chip
//     flash; MODE2 is internally GND on QN48; MODE0/MODE1 strapped 0,0);
//   * UG293-1.3.4E schematic manual (strap/cap/resistor guidance);
//   * UG846-1.1E automotive package doc (pin-9 hazard cross-check).
//
// The 26 tile nets = fpga/docs/pin_budget.md (rev-A merged board nets).
// RESERVED pins (never assigned here, brought to JTAG/test pads on the PCB):
//   3 TCK, 4 TMS, 5 TDI, 7 TDO, 44 JTAGSEL_N, 48 RECONFIG_N, 45 READY,
//   46 DONE, 42 MODE1 (GND strap), 43 MODE0 (GND strap);
// power/ground: 1 VCCIO0, 25 VCCIO1 (3V3), 36 VCCX (3V3), 12+37 VCC (1V2),
// 2+26 VSS, EPAD GND.
// Pin 9 deliberately NOT used: automotive UG846 disagrees with UG842 on pin 9
// (VCC vs IOR2A) - order-code hazard, 26 IO fit without it.
//
// Pull semantics (GW1NZ LVCMOS33 pads support PULL_MODE UP and DOWN):
//   UP inputs : clk_pin, t_w_pin, t_endcol_pin, b_first_pin, l_endrow_pin
//   DOWN inputs: t_data_pin, l_data_pin, b_latch_pin, r_latch_pin
//   keys[11:0]: pad pull-DOWN added on the board variant (rev-A passive key
//   plan = switch to VCC + 10k pull-down; the pad internal pull-down is
//   sufficient and removes 12 resistors - see docs/power_reg.md).
//   NOTE: pad pull strengths are weak types from UG842 pin definitions;
//   if bench shows key debounce/level issues, outward fix = external 10k.

// 12 keys (SMD hot-swap, one key/contact). VCC-switched, pad pull-down.
IO_LOC "keys[0]"  8;  IO_PORT "keys[0]"  PULL_MODE=DOWN;
IO_LOC "keys[1]"  10; IO_PORT "keys[1]"  PULL_MODE=DOWN;
IO_LOC "keys[2]"  11; IO_PORT "keys[2]"  PULL_MODE=DOWN;
IO_LOC "keys[3]"  13; IO_PORT "keys[3]"  PULL_MODE=DOWN;
IO_LOC "keys[4]"  16; IO_PORT "keys[4]"  PULL_MODE=DOWN;
IO_LOC "keys[5]"  17; IO_PORT "keys[5]"  PULL_MODE=DOWN;
IO_LOC "keys[6]"  18; IO_PORT "keys[6]"  PULL_MODE=DOWN;
IO_LOC "keys[7]"  20; IO_PORT "keys[7]"  PULL_MODE=DOWN;
IO_LOC "keys[8]"  21; IO_PORT "keys[8]"  PULL_MODE=DOWN;
IO_LOC "keys[9]"  23; IO_PORT "keys[9]"  PULL_MODE=DOWN;
IO_LOC "keys[10]" 33; IO_PORT "keys[10]" PULL_MODE=DOWN;
IO_LOC "keys[11]" 34; IO_PORT "keys[11]" PULL_MODE=DOWN;

// merged 20 MHz shift clock (J103.2 = J104.2) on the GCLKT_0 pad
IO_LOC "clk_pin"      47; IO_PORT "clk_pin"      PULL_MODE=UP;

// rev-A pull-UP strap inputs
IO_LOC "t_w_pin"      38; IO_PORT "t_w_pin"      PULL_MODE=UP;
IO_LOC "t_endcol_pin" 39; IO_PORT "t_endcol_pin" PULL_MODE=UP;
IO_LOC "b_first_pin"  40; IO_PORT "b_first_pin"  PULL_MODE=UP;
IO_LOC "l_endrow_pin" 41; IO_PORT "l_endrow_pin" PULL_MODE=UP;

// rev-A pull-DOWN inputs
IO_LOC "t_data_pin"   28; IO_PORT "t_data_pin"   PULL_MODE=DOWN;
IO_LOC "l_data_pin"   24; IO_PORT "l_data_pin"   PULL_MODE=DOWN;
IO_LOC "b_latch_pin"  22; IO_PORT "b_latch_pin"  PULL_MODE=DOWN;
IO_LOC "r_latch_pin"  32; IO_PORT "r_latch_pin"  PULL_MODE=DOWN;

// outputs (t_clk/l_clk are true tri-state TBUF, verified by the fpga flow)
// Termination decision (2026-10-14, docs/termination.md): the certified
// 19-contact frame is KEPT (merged forward-driven outputs on one board
// net each). / below are UNVERIFIED VENDOR HINTS:
// spelled per SUG935 A.2 (documented form is SLEW_RATE), syntactically
// valid Gowin cst, but NO Gowin-EDA run has ever been executed here, so
// whether the vendor flow honors them is UNVERIFIED. Evidence (2026-10-14)
// about the OSS flow only: nextpnr-himbaechel (oss-cad-suite 2026-09-26)
// silently ignores these attributes - A/B runs differing only in
// vs yield byte-identical .fs, and the libexec
// binary contains no slew-attribute string. With the OSS flow the pads
// therefore run at silicon-default drive/slew; ringing margin on the
// unterminated chassis runs is bench-gated (B2, docs/termination.md).
IO_LOC "t_clk_pin"  35; IO_PORT "t_clk_pin"  IO_TYPE=LVCMOS33;
IO_LOC "l_clk_pin"  19; IO_PORT "l_clk_pin"  IO_TYPE=LVCMOS33;
IO_LOC "latcho_pin" 31; IO_PORT "latcho_pin" IO_TYPE=LVCMOS33;
IO_LOC "dout_pin"   30; IO_PORT "dout_pin"   IO_TYPE=LVCMOS33;
IO_LOC "b_w_pin"    27; IO_PORT "b_w_pin"    IO_TYPE=LVCMOS33;
