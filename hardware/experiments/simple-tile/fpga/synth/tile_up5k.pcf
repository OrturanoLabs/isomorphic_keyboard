# SPDX-License-Identifier: CERN-OHL-S-2.0
# iCE40UP5K-SG48 pin proposal for the tile. 26 user IO of 39 IO-capable pads
# (empirical probe: pads 1,5,7,8,22,24,29,30,33 are not IO).
# clk_pin is the merged B_clk/R_clk board net (J103.2 = J104.2).
# iCE40 pads have pull-UP only -> the four rev-A DOWN pulls (t_data, l_data,
# b_latch, r_latch) need +4 board resistors on this variant (power_bom.md).

set_io keys[0] 2
set_io keys[1] 3
set_io keys[2] 4
set_io keys[3] 6
set_io keys[4] 9
set_io keys[5] 10
set_io keys[6] 11
set_io keys[7] 12
set_io keys[8] 13
set_io keys[9] 14
set_io keys[10] 15
set_io keys[11] 16

set_io -pullup yes clk_pin 17
set_io -pullup yes t_w_pin 18
set_io -pullup yes t_endcol_pin 19
set_io -pullup yes b_first_pin 20
set_io -pullup yes l_endrow_pin 21

set_io t_data_pin 23
set_io l_data_pin 25
set_io b_latch_pin 26
set_io r_latch_pin 27

set_io t_clk_pin 28
set_io l_clk_pin 31
set_io latcho_pin 32
set_io dout_pin 34
set_io b_w_pin 35
