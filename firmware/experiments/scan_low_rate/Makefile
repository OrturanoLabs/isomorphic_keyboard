# Paths and files
OSS_CAD_SUITE ?=
OSS_CAD_BIN = $(if $(OSS_CAD_SUITE),$(OSS_CAD_SUITE)/bin,$(patsubst %/yosys,%,$(shell command -v yosys)))
DFU_UTIL    = $(OSS_CAD_BIN)/dfu-util

# Project files
TOP_ENTITY  = top
VHDL_FILE   = top.vhd
DEP1 	    = i2c_master.vhd
PCF_FILE    = up5k.pcf

# pico-ice USB id and serial number (set your own)
USB_ID      = 1209:b1c0
SERIAL_NUM  = DE64481247531337

# Files generated by the toolchain
JSON_FILE   = hardware.json
ASC_FILE    = hardware.asc
BIN_FILE    = hardware.bin

# Default target: build up to the bitstream
all: $(BIN_FILE)

# 1. Synthesis (depends on the VHDL files)
$(JSON_FILE): $(VHDL_FILE)
	$(OSS_CAD_BIN)/yosys -m ghdl -p "ghdl -fsynopsys -fexplicit $(DEP1) $(VHDL_FILE) -e $(TOP_ENTITY); synth_ice40 -json $(JSON_FILE)"

# 2. Place & route (depends on the synthesis JSON and the PCF)
$(ASC_FILE): $(JSON_FILE) $(PCF_FILE)
	$(OSS_CAD_BIN)/nextpnr-ice40 --up5k --package sg48 --json $(JSON_FILE) --pcf $(PCF_FILE) --asc $(ASC_FILE)

# 3. Bitstream generation (depends on the P&R ASC)
$(BIN_FILE): $(ASC_FILE)
	$(OSS_CAD_BIN)/icepack $(ASC_FILE) $(BIN_FILE)

# Upload to flash (DFU alt 0)
upload-flash: $(BIN_FILE)
	$(DFU_UTIL) -d $(USB_ID) -S $(SERIAL_NUM) -a 0 -R -D $(BIN_FILE)

# Upload to volatile CRAM (DFU alt 1)
upload-ram: $(BIN_FILE)
	$(DFU_UTIL) -d $(USB_ID) -S $(SERIAL_NUM) -a 1 -D $(BIN_FILE)

# Remove generated temporary files
clean:
	rm -f $(JSON_FILE) $(ASC_FILE) $(BIN_FILE) e~*.o work-obj93.cf

.PHONY: all upload-flash upload-ram clean
